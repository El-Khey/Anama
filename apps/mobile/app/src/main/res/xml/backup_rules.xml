<?xml version="1.0" encoding="utf-8"?><!--
    Même règle que data_extraction_rules.xml, pour les appareils sous Android 11 et
    antérieurs — eux lisent ce fichier-ci, les plus récents lisent l'autre. Les deux
    doivent donc rester d'accord : on exclut le fichier du token, dont la clé de
    déchiffrement ne quitte jamais le téléphone et ne peut donc pas être restaurée avec
    lui. Voir data_extraction_rules.xml pour le détail.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="novelrealm_secure_prefs.xml" />
</full-backup-content>

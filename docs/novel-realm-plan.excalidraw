    {
      "id": "v2_26",
      "type": "text",
      "x": 4405,
      "y": 479.25,
      "width": 407.55,
      "height": 178.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

    {
      "id": "v2_17",
      "type": "text",
      "x": 3905,
      "y": 511.75,
      "width": 400.4,
      "height": 162.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

      "text": "🔒  Anti-spoil",
      "originalText": "🔒  Anti-spoil",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,

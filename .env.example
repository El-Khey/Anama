# =====================================================================
#  Modèle du fichier .env — À COPIER EN « .env », qui n'est jamais versionné.
#
#      cp .env.example .env     puis remplir les valeurs
#
#  Docker Compose lit ce fichier automatiquement et remplace les ${…} des
#  docker-compose*.yml. Sur le serveur, c'est le SEUL fichier à éditer.
# =====================================================================

# ── Secrets applicatifs (obligatoires) ───────────────────────────────

# Clé de signature des jetons de connexion. AU MOINS 32 octets.
# En générer une : openssl rand -base64 48
JWT_SECRET=

# Compte SMTP d'envoi des mails (vérification d'adresse, mot de passe oublié).
MAIL_USERNAME=
MAIL_PASSWORD=

# Identifiants « Se connecter avec Google » (console Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── GIF dans les commentaires (FACULTATIF) ───────────────────────────
#
# Clé de l'API KLIPY (gratuite : partner.klipy.com → API Keys → Add
# Platform). L'API fait proxy : la clé ne quitte jamais le serveur.
# LAISSÉE VIDE, tout fonctionne — l'app masque simplement le bouton GIF.
#
# NB : c'était Tenor jusqu'à ce que Google ferme cette API aux
# développeurs (inscriptions closes le 13/01/2026, arrêt le 30/06/2026).
KLIPY_API_KEY=


# ── Adresse publique du site ─────────────────────────────────────────
#
# Celle que voient les utilisateurs. Elle sert aux liens dans les e-mails
# (« Commencer à lire ») et à la redirection après connexion Google.
# Sans elle, les mails envoient vos lecteurs sur LEUR propre machine.
# Sur le serveur : http://192.168.1.x   (sans slash final, sans /api)
FRONTEND_URL=http://localhost:5173


# ── Tunnel Cloudflare (accès depuis l'extérieur) ─────────────────────
#
# Jeton du tunnel, à créer dans le tableau de bord Cloudflare :
#   Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared
#   puis, dans « Public hostname » :
#       novel-api . iap.software        type HTTP        URL  api:8080
#   (« api:8080 » = le NOM du service Docker, pas une IP : cloudflared tourne
#    sur le même réseau interne que l'API.)
#
# Le jeton porte l'identité du tunnel et ses clés : il vaut un mot de passe.
# Laissé vide, tout fonctionne — `make prod` ignore simplement le tunnel ;
# c'est `make tunnel` qui le démarre.
CLOUDFLARE_TUNNEL_TOKEN=


# ── Base de données ──────────────────────────────────────────────────

# ⚠️ Lu UNIQUEMENT à la création du volume, c'est-à-dire au tout premier
# démarrage. Le changer ensuite ne change PAS le mot de passe réel : il
# faudrait un « ALTER USER novelrealm PASSWORD '…' » dans psql.
# Donc : le définir MAINTENANT, avant le premier `make prod` du serveur.
# En générer un : openssl rand -base64 24
DB_PASSWORD=


# ── Publication des ports ────────────────────────────────────────────
#
#  Non renseignés, les défauts conviennent au DÉVELOPPEMENT :
#      WEB_PUBLISH=5173     API_PUBLISH=8080     DB_PUBLISH=5433
#  …tous joignables depuis le réseau.
#
#  SUR LE SERVEUR, décommenter les trois lignes ci-dessous :
#
#   • le front devient joignable en http://<ip-du-serveur>/ (sans port) ;
#   • l'API et la base ne sont plus joignables QUE depuis le serveur
#     lui-même (127.0.0.1) — pratique pour déboguer, invisible du réseau.
#     Les utilisateurs passent par nginx, qui relaie /api en interne.

# WEB_PUBLISH=80
# API_PUBLISH=127.0.0.1:8080
# DB_PUBLISH=127.0.0.1:5433
#
#  AVEC LE TUNNEL, garder API_PUBLISH=127.0.0.1:8080 : le tunnel joint l'API
#  par le réseau interne Docker, jamais par ce port. Cloudflare devient alors
#  la seule porte d'entrée, et le port 8080 disparaît du réseau local.
